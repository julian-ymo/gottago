<item name="colorPrimary">@color/ink</item><item name="colorPrimaryDark">@color/ink</item><item name="colorAccent">@color/yellow</item>
<item name="android:windowBackground">@color/ink</item><item name="android:statusBarColor">@color/ink</item>
